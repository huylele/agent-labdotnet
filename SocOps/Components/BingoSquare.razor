@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace && !IsWinning)
    {
        <span class="absolute top-0.5 right-0.5 text-win-black text-xs font-bold">X</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "relative flex items-center justify-center p-1 text-center transition-all duration-150 select-none min-h-[60px] text-xs leading-tight";

        var stateClasses = Square.IsMarked
            ? IsWinning
                ? "bg-win-blue text-win-white border-inset font-bold"
                : "bg-white text-win-black border-inset"
            : "bg-win-gray text-win-black win-btn";

        if (Square.IsFreeSpace)
        {
            return $"{baseClasses} bg-win-teal text-win-white border-inset font-bold text-sm";
        }

        return $"{baseClasses} {stateClasses}";
    }
}
