<div class="flex flex-col items-center justify-center min-h-full p-6">
    <div class="window max-w-sm w-full">
        <div class="window-title">
            <span>Social_Bingo.exe</span>
            <button class="win-btn p-1 px-2 text-xs" style="min-height:unset" disabled>X</button>
        </div>
        <div class="p-6 bg-win-gray text-center">
            <h1 class="text-4xl font-bold text-win-black mb-2">Soc Ops</h1>
            <p class="text-lg text-gray-800 mb-8">Social Bingo</p>

            <div class="border-inset bg-white p-4 mb-8 text-left">
                <h2 class="font-bold text-win-black mb-3">How to play:</h2>
                <ul class="text-win-black text-sm space-y-2">
                    <li>• Find people who match the questions</li>
                    <li>• Tap a square when you find a match</li>
                    <li>• Get 5 in a row to win!</li>
                </ul>
            </div>

            <button
                @onclick="OnStart"
                class="w-full win-btn font-bold py-3 text-lg">
                Start Game
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
