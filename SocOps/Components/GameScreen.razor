@using SocOps.Models

<div class="flex flex-col items-center min-h-full p-3">
    <div class="window w-full max-w-md flex flex-col h-full">
        <!-- Title Bar -->
        <div class="window-title">
            <span>SocOps_Game.exe</span>
            <button class="win-btn p-1 px-2 text-xs" style="min-height:unset" @onclick="OnReset">X</button>
        </div>

        <div class="flex-1 flex flex-col bg-win-gray p-2">
            <!-- Header Controls -->
            <header class="flex items-center justify-between mb-3">
                <button
                    @onclick="OnReset"
                    class="win-btn text-sm font-bold">
                    ← Restart
                </button>
                <div class="border-inset bg-white px-2 py-1 flex-1 mx-2 text-center text-sm font-bold">
                    System ready.
                </div>
            </header>

            <!-- Instructions -->
            <p class="text-center text-win-black text-sm mb-2 border-inset bg-white py-1">
                Tap a square when you find someone who matches it.
            </p>

            <!-- Bingo indicator -->
            @if (HasBingo)
            {
                <div class="mb-2 border-outset bg-win-blue text-win-white text-center py-2 font-bold animate-[bounce_0.5s_ease-out]">
                    *** BINGO! SYSTEM OVERRIDE ***
                </div>
            }

            <!-- Board -->
            <div class="flex-1 flex items-center justify-center mt-2">
                <BingoBoard
                    Board="@Board"
                    WinningSquareIds="@WinningSquareIds"
                    OnSquareClick="@OnSquareClick" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
